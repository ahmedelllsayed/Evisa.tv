# Copy to .env.local and fill in what you use. Everything is optional for local development:
# without these values the app uses an embedded database (.data/pglite), built-in email
# sign-in (the code is shown on the sign-in page in development), local file storage and a test checkout.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres + Auth + Storage + Realtime) ---
# Postgres connection string (Project Settings > Database > Connection string, "Transaction pooler").
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Storage uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Secret used to sign the local session cookie. Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that get access to /admin.
ADMIN_EMAILS=admin@example.com

# --- Payments ---
# Provider order: Paymob (when fully configured), then Stripe, then the local test checkout.
# The test checkout is disabled in production. Leave Paymob empty to keep Stripe or the local checkout.
#
# Paymob Accept Intention API. Never expose the secret, API, or HMAC values to the browser.
# Test and live are different keys and integration IDs on the same API host.
# Create the intention on PAYMOB_BASE_URL. Egypt hosted checkout defaults to https://eg.checkout.paymob.com/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Online card (and optional online wallet) integration IDs.
# Leave empty until a new Online card integration exists. Do not reuse evisa.tv id 2729467.
PAYMOB_INTEGRATION_IDS=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/
# Stripe test mode. Used when Paymob is not fully configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend). Empty key keeps the development sign-in code on the page. ---
RESEND_API_KEY=
RESEND_FROM=

# Optional: where the embedded database lives (defaults to .data/pglite).
LOCAL_DB_DIR=
